# MAXXAGENT — environment template (copy to .env.local and fill in)

# Builder Code from https://dashboard.base.org -> Settings -> Project Settings -> Builder Code
NEXT_PUBLIC_BASE_BUILDER_CODE=

# Dedicated Base Mainnet RPC (server-only). Empty = public https://mainnet.base.org (rate-limited)
BASE_RPC_URL=

# Public site URL (used for Open Graph / X preview images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for `npm run deploy:mainnet` — fresh deployer wallet with a little ETH. Never commit.
DEPLOYER_PRIVATE_KEY=

# Filled automatically by `npm run deploy:mainnet`
NEXT_PUBLIC_INDEX_REGISTRY_ADDRESS=

# Mobile wallet login (WalletConnect / Reown project id, 32 hex chars). Add your domain to Reown Allowed Domains.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Only for `npm run test:buy` / `npm run test:sell` with --execute: a burner wallet with a few USDC. Never commit.
TEST_BUYER_PRIVATE_KEY=

# Optional: contract verification (not used yet)
ETHERSCAN_API_KEY=
